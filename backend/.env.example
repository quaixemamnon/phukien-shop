# ===== Server =====
PORT=5000
# Địa chỉ frontend (dùng cho CORS và link trong email). Nhiều địa chỉ cách nhau bằng dấu phẩy
CLIENT_URL=http://localhost:5173
# Địa chỉ công khai của backend (dùng để tạo link ảnh khi lưu ảnh trên máy chủ)
SERVER_URL=http://localhost:5000

# ===== MongoDB =====
# Máy cá nhân: mongodb://127.0.0.1:27017/phukien_shop
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/phukien_shop
MONGO_URI=mongodb://127.0.0.1:27017/phukien_shop

# ===== JWT =====
JWT_SECRET=doi_chuoi_nay_thanh_mot_chuoi_bi_mat_dai
JWT_EXPIRES=7d

# ===== Cloudinary (không bắt buộc - bỏ trống thì ảnh lưu vào thư mục uploads/) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Email (không bắt buộc - bỏ trống thì nội dung email in ra console) =====
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS là "Mật khẩu ứng dụng"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kayden Store <no-reply@kaydenstore.vn>"

# ===== MoMo =====
# MOMO_MODE=mock : mô phỏng cổng MoMo ngay trong website (không cần tài khoản MoMo, không có tiền thật) - dùng để demo
# MOMO_MODE=real : gọi cổng MoMo thật, cần điền 3 khóa bên dưới
#                  (lấy tại https://business.momo.vn, mục Tích hợp - Môi trường test)
# Để trống MOMO_MODE và 3 khóa = tắt MoMo
# Lưu ý: bộ khóa test công khai cũ (partnerCode=MOMO) hiện bị cổng test của MoMo từ chối (HTTP 403)
MOMO_MODE=mock
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo-return
# IPN phải là địa chỉ công khai (VD dùng ngrok) thì MoMo mới gọi được
MOMO_IPN_URL=http://localhost:5000/api/payment/momo-ipn

# ===== Tài khoản tạo bởi lệnh npm run seed =====
SEED_ADMIN_EMAIL=admin@kaydenstore.vn
SEED_ADMIN_PASSWORD=Admin@123
